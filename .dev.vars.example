SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET
FASTGPT_API_KEY=REPLACE_WITH_MAIN_APP_KEY
MEMORY_API_KEY=REPLACE_WITH_EXTRACTOR_APP_KEY
TURNSTILE_SECRET_KEY=REPLACE_FOR_PUBLIC_GUEST_MODE

SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_OR_ANON_KEY
TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY

ALLOWED_ORIGINS=http://localhost:8080
GUEST_ENABLED=false
TURNSTILE_HOSTNAMES=localhost


# 可选：独立访客通行凭证签名密钥；不设置时复用带用途前缀的 TURNSTILE_SECRET_KEY
# GUEST_SESSION_SECRET="至少32字节的随机字符串，不可公开"
